# Database Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_bot

# NextAuth Configuration
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-super-secret-key-generate-with-openssl
NEXTAUTH_URL=http://localhost:3000

# WhatsApp Configuration
WHATSAPP_SESSION_PATH=./sessions

# Google Sheets API
# Option 1: Service Account JSON (base64 encoded)
# Encode with: cat service-account.json | base64
GOOGLE_SHEETS_CREDENTIALS=

# Target Spreadsheet ID
# Get from URL: https://docs.google.com/spreadsheets/d/SHEET_ID/edit
GOOGLE_SHEET_ID=

# Admin Account (for seeding)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=SecurePassword123!
ADMIN_NAME=Admin User

# App Configuration
NODE_ENV=development
PORT=3000

# Default business settings
DEFAULT_BUSINESS_NAME=My Business
DEFAULT_REPLY=شكراً لتواصلك معنا! سنرد عليك قريباً.
